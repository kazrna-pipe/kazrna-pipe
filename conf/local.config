// conf/local.config

params {
    config_profile_name        = 'local'
    config_profile_description = 'Single workstation - for development and small datasets'
    max_cpus   = 8      // set to your machine's core count
    max_memory = 64.GB
    max_time   = 48.h
}

process {
    executor = 'local'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/.singularity_cache"
}

// Ceiling applied to every process request in conf/base.config.
// Declared here, not in base.config, because base.config is parsed
// before params{} exists and would see null values.
process.resourceLimits = [ cpus: 8, memory: 64.GB, time: 48.h ]
