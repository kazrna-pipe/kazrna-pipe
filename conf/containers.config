// conf/containers.config
//
// Every process runs in a pinned container; nothing executes on the host.
//
// Images are referenced by immutable digest rather than by tag. A tag can be
// repointed at different content at any time, so a tag-pinned pipeline offers
// no guarantee that a later run uses the same software. A digest is a hash of
// the image content: it either resolves to exactly these bytes or fails.
//
// Digests, build dates and sizes are recorded in containers/MANIFEST.md.
// The images are rebuilt by containers/build.sh from the Dockerfiles in that
// directory, each of which ends with a layer that fails the build if any
// required package is absent.

process {

    // ---- R: bulk quantification aggregation, differential expression,
    //         concordance, enrichment, deconvolution ---------------------------
    withName: 'MERGE_COUNTS|MERGE_STAR|MERGE_HISAT2|TXIMPORT|DESEQ2|EDGER|LIMMA_VOOM|CONCORDANCE|CLUSTERPROFILER|CELLTYPE_DE|BAYESPRISM|MUSIC|DECONV_AGREEMENT' {
        container = 'ghcr.io/kazrna-pipe/kazrna-bulk@sha256:449731ddf753317a5026161e7e05eb73d2e74186b425ca3e826204db390ab427'
    }

    // ---- R: single-cell CPU path (Seurat, Harmony, python leidenalg) ---------
    withName: 'SEURAT_WORKFLOW' {
        container = 'ghcr.io/kazrna-pipe/kazrna-seurat@sha256:034eefc888af1f3efe22bb65821040cead37c8995a16ed731652b0765ab7cf2b'
    }

    // ---- Python: single-cell GPU path, clustering agreement, version
    //              collection ------------------------------------------------
    // rapids-singlecell requires CUDA. The workflow script falls back to
    // Scanpy when the import fails, so this CPU image exercises the same code
    // path on a runner without a GPU.
    withName: 'RAPIDS_SINGLECELL|CLUSTERING_AGREEMENT|SOFTWARE_VERSIONS' {
        container = 'ghcr.io/kazrna-pipe/kazrna-py@sha256:17bc730681ca90d649f1bf25840f4672ded381747338085e0e6645a1c63f6832'
    }

    // ---- Third-party tool images, used unmodified from BioContainers --------
    withName: 'FEATURECOUNTS|FEATURECOUNTS_STAR|FEATURECOUNTS_HISAT2' {
        container = 'quay.io/biocontainers/subread:2.0.6--he4a0461_2'
    }
    withName: 'SAMTOOLS_SORT' {
        container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0'
    }

    // FASTQC, TRIMGALORE, STAR_ALIGN, HISAT2_ALIGN and SALMON_QUANT declare
    // their own containers in the module files.
}
