/*
 * Resource caps for a single workstation with 28 cores and 94 GB RAM.
 *
 * nextflow.config sets max_memory = 512.GB and declares no top-level
 * resourceLimits, so without a profile the process_high_memory label requests
 * 192 GB and fails submission on any machine smaller than a cluster node.
 *
 * 80 GB leaves headroom for the OS and Docker. STAR against GRCh38 needs
 * roughly 32-40 GB, so process_high at 48 GB is sufficient.
 */

params {
    max_cpus   = 26
    max_memory = 80.GB
    max_time   = 96.h
}

process.resourceLimits = [ cpus: 26, memory: 80.GB, time: 96.h ]

process {
    withLabel: process_high        { cpus = 12; memory = { 48.GB * task.attempt } }
    withLabel: process_high_memory { cpus = 8;  memory = { 72.GB * task.attempt } }
}
