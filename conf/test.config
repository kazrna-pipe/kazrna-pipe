// conf/test.config
//
// Minimal CI / smoke-test profile. Uses subsampled FASTQ + a 2000-cell single-
// cell matrix shipped in test_data/. Designed to complete on a 2-vCPU, 7 GB
// GitHub-hosted runner in under 12 minutes.

params {
    config_profile_name        = 'test'
    config_profile_description = 'Minimal smoke-test dataset for CI'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // Tiny test inputs (≈ 1 GB total) - see test_data/README.md for SHA-256.
    bulk_samplesheet = "${projectDir}/test_data/bulk_samplesheet.csv"
    sc_samplesheet   = "${projectDir}/test_data/sc_samplesheet.csv"

    star_index    = "${projectDir}/test_data/refs/star_index_chr22"
    hisat2_index  = "${projectDir}/test_data/refs/hisat2_index_chr22"
    salmon_index  = "${projectDir}/test_data/refs/salmon_index_chr22"
    gtf           = "${projectDir}/test_data/refs/gencode.v44.chr22.gtf.gz"
    tx2gene       = "${projectDir}/test_data/refs/tx2gene.chr22.tsv"
    marker_yaml   = "${projectDir}/data/celltype_markers.yaml"

    // Skip expensive parts in CI
    skip_benchmark    = true
    skip_deconvolution = false
    sc_n_hvgs         = 1000
    sc_n_pcs          = 20
    sc_resolutions    = '0.5,1.0'

    // No external token in CI
    cibersortx_token = null
}

process {
    // Override accelerator: CI runners have no GPU; force CPU fallback for sc.
    withLabel: process_gpu {
        accelerator = null
        ext.gpu_disabled = true
    }
}
