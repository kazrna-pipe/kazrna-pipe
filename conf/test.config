// conf/test.config
//
// Minimal CI / smoke-test profile. Exercises the full workflow graph on a tiny
// chr22 dataset shipped in test_data/. CPU-only; no GPU, no deconvolution,
// no HPC benchmark. Designed to complete on a 2-vCPU / 6 GB runner.

params {
    config_profile_name        = 'test'
    config_profile_description = 'Minimal smoke-test dataset for CI'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    // Input sample sheets and reference bundle
    input     = "${projectDir}/test_data/bulk_samplesheet.csv"
    sc_input  = "${projectDir}/test_data/sc_samplesheet.csv"
    refs_dir  = "${projectDir}/test_data/refs"

    marker_yaml = "${projectDir}/data/celltype_markers.yaml"

    // Skip expensive / unavailable stages in CI
    run_gpu       = false
    run_benchmark = false
    skip_deconv   = true

    // single-cell params (real integers — NOT placeholders)
    sc_hvg_n              = 2000
    sc_n_pcs              = 20
    sc_leiden_resolutions = '0.5,1.0'

    // No external token in CI
    cibersortx_token = null
}

process {
    withLabel: process_gpu {
        accelerator = null
        ext.gpu_disabled = true
    }
}
