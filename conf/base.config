// conf/base.config
//
// Process resource defaults for KazRNA-Pipe.
//
// Requests below are what each process asks for. Nextflow clamps every request
// to the ceiling declared in `resourceLimits`, which each profile in conf/ sets
// for its target platform via max_cpus / max_memory / max_time. This replaces
// the former check_max() helper, which is not valid in Nextflow's current
// config parser. Requires Nextflow >= 24.04.

process {

    // ---- Defaults for any process without a label --------------------------
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ---- Labelled resource classes -----------------------------------------
    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withLabel: process_low {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withLabel: process_medium {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withLabel: process_high_memory {
        cpus   = 16
        memory = { 192.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    withLabel: process_gpu {
        cpus        = 8
        memory      = { 64.GB * task.attempt }
        time        = { 12.h  * task.attempt }
        accelerator = [request: 1, type: 'nvidia']
    }

    withLabel: process_benchmark {
        cpus   = 64
        memory = 256.GB
        time   = 24.h
    }
}
