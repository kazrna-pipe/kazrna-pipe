// conf/slurm.config


params {
    config_profile_name        = 'slurm'
    config_profile_description = 'KazHPC SLURM cluster - CPU + GPU partitions'

    max_cpus   = 64
    max_memory = 512.GB
    max_time   = 72.h

    slurm_account   = System.getenv('SLURM_ACCOUNT')   ?: 'kazrna'
    slurm_partition_cpu = 'cpu'
    slurm_partition_gpu = 'gpu'
}

process {
    executor       = 'slurm'
    queue          = params.slurm_partition_cpu
    clusterOptions = { "--account=${params.slurm_account}" }

    withLabel: process_gpu {
        queue          = params.slurm_partition_gpu
        clusterOptions = { "--account=${params.slurm_account} --gres=gpu:a100:1" }
    }
    withLabel: process_benchmark {
        queue          = params.slurm_partition_gpu
        clusterOptions = { "--account=${params.slurm_account} --exclusive --gres=gpu:a100:4" }
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/scratch/${USER}/singularity_cache'
    runOptions = '--nv --cleanenv'
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}

// Ceiling applied to every process request in conf/base.config.
// Declared here, not in base.config, because base.config is parsed
// before params{} exists and would see null values.
process.resourceLimits = [ cpus: 64, memory: 512.GB, time: 72.h ]
