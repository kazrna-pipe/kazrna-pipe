    family-names: Zhumadillayeva
    orcid: "https://orcid.org/0000-0003-1042-0415"
    affiliation: L.N. Gumilyov Eurasian National University
version: 1.1.0
date-released: "2026-08-04"
license: MIT
repository-code: "https://github.com/kazrna-pipe/kazrna-pipe"
keywords:
  - RNA-seq
  - single-cell
  - Nextflow
  - reproducibility
  - deconvolution
  - GPU acceleration
