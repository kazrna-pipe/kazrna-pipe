# --- Singularity / containers ---
containers/cache/
*.sif
.singularity_cache/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env

# --- R ---
.Rhistory
.RData
.Rproj.user/
*.rds
renv/library/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
*.swp

docs/_build/
docs/_site/

# --- Secrets ---
.cibersortx_token
*.pem
*.key

# Downloaded TCGA counts. Regenerate with bin/fetch_tcga_esca.sh; the query
# filters are in the script, so the cohort definition is version-controlled
# even though the data is not.
data/tcga_esca/*/
data/tcga_esca/gdc_manifest.tsv

